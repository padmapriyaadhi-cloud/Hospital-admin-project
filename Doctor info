		String dob=sc.next();
		System.out.println("Enter doctor id=");
		int doctor_id=sc.nextInt();
		System.out.println("Enter fees_structure=");
		int fees_structure=sc.nextInt();
		System.out.println("Enter doctor timing=");
		String doctor_timing=sc.next();
		Connection con=DriverManager.getConnection("jdbc:mysql://localhost/hospitaldb","root","adhikesavan05");
		PreparedStatement ps=con.prepareStatement("insert into doctorinfo values(?,?,?,?,?,?,?,?,?,?,?,?)");
