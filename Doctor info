		ps.setString(2,gender);
		ps.setString(3, specialization);
		ps.setLong(4,phno);
		ps.setString(5, email_id);
		ps.setString(6, address);
		ps.setInt(7, department_id);
		ps.setString(8, status);
		ps.setString(9, dob);
		ps.setInt(10, doctor_id);
