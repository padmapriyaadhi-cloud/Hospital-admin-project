		            System.out.println("Blood group=" + rs.getString(10));
		            System.out.println("Registration date= " + rs.getString(11));
		            System.out.println("Disease=" + rs.getString(12));
		            System.out.println("Medical history =" + rs.getString(13));
		            count++;
		        }
		        if (count == 0) {
		            System.out.println("Invalid Name");
		        }
		        con.close();
		    } catch (Exception e) {
		        System.out.println(e);
		    }
		}

