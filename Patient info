package crud;
import java.util.Scanner;
import java.sql.*;

public class patientinfo {
	Scanner sc=new Scanner(System.in);
	void patientdetails() {
		while(true) {
			System.out.println("\n----Patient Deatils----");
			System.out.println("\n1.Add Patients\n2.Update Patients\n3.Delete Patients\n4.Find Patients\n5.Print Patients\n6.Exit\nChoose any option=");
			int pa=sc.nextInt();
			if(pa==1) {
				addpatientinfo();
			}
			else if(pa==2) {
				updatepatientinfo();
			}
			
			else if(pa==3) {
				deletepatientinfo();
			}
			else if(pa==4) {
				findpatientinfo();
			}
			else if(pa==5) {
				printpatientinfo();
			}
			else if(pa==6) {
				System.out.println("Thank you...");
				break;
			}
			else {
				System.out.println("Invalid choice");
			}
		}
	}
	
	
	void addpatientinfo() {
		try {
			System.out.println("Enter patient id=");
			int patient_id=sc.nextInt();
			System.out.println("Enter patient name=");
			String patient_name=sc.next();
			System.out.println("Enter gender=");
			String gender=sc.next();
			System.out.println("Enter age=");
			String age=sc.next();
			System.out.println("Enter phone number=");
			long phone_num=sc.nextLong();
			System.out.println("Enter email id=");
			String email_id=sc.next();
			System.out.println("Enter emergency name=");
			String emergency_name=sc.next();
			System.out.println("Enter emergency contact=");
			long emergency_contact=sc.nextLong();
			System.out.println("Enter blood group=");
			String blood_group=sc.next();
			System.out.println("Enter registration_date=");
			String registration_date=sc.next();
			System.out.println("Enter disease=");
			String disease=sc.next();
			System.out.println("Enter doctor id=");
			int doctor_id=sc.nextInt();
			System.out.println("Enter medical_history=");
			String medical_history=sc.next();
			Connection con=DriverManager.getConnection("jdbc:mysql://localhost/hospitaldb","root","adhikesavan05");
			PreparedStatement ps=con.prepareStatement("insert into patientinfo values(?,?,?,?,?,?,?,?,?,?,?,?,?)");
			ps.setInt(1, patient_id);
			ps.setString(2, patient_name);
			ps.setInt(3, doctor_id);
			ps.setString(4,gender);
			ps.setString(5, age);
			ps.setLong(6,phone_num);
			ps.setString(7, email_id);
			ps.setString(8, emergency_name);
			ps.setLong(9, emergency_contact);
			ps.setString(10, blood_group);
			ps.setString(11, registration_date);
			ps.setString(12, disease);
			ps.setString(13,medical_history);
			int result=ps.executeUpdate();
			con.close();
			System.out.println((result!=0)?"Data saved...":"Data not saved...");
			
		}
		catch(Exception e) {
			System.out.println(e);
		}
	}
	
	 void updatepatientinfo()
	    {
	        try
	        {
	            System.out.println("Enter medical_history=");
	            String medical_history = sc.nextLine();
	            System.out.println("Enter patient_name=");
	            String patient_name=sc.nextLine();
	            Connection con = DriverManager.getConnection("jdbc:mysql://localhost/hospitaldb","root","adhikesavan05");
	            PreparedStatement ps = con.prepareStatement("update patientinfo set medical_history = ? where patient_name =?");
	            ps.setString(1, medical_history);
	            ps.setString(2, patient_name);
	            int result = ps.executeUpdate();
	            con.close();
	            System.out.println((result!=0)?"Data updated..." : "Invalid name");    
	        }
	        catch(Exception e)
	        {
	            System.out.println(e);
	        }
	    }
	 
	 void deletepatientinfo()
	    {
	        try
	        {
	            System.out.println("Enter patient_name=");
	            String patient_name = sc.next();
	           
	            Connection con = DriverManager.getConnection("jdbc:mysql://localhost/hospitaldb","root","adhikesavan05");
	            PreparedStatement ps = con.prepareStatement("delete from patientinfo where patient_name =?");
	            ps.setString(1, patient_name);
	            int result = ps.executeUpdate();
	            con.close();
	            System.out.println((result!=0)?"Data Deleted..." : "Invalid name");    
	        }
	        catch(Exception e)
	        {
	            System.out.println(e);
	        }
	    }
	 
	 void findpatientinfo() {
		    try {
