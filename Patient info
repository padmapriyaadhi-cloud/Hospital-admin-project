		        String patient_name = sc.nextLine(); 
		        Connection con = DriverManager.getConnection("jdbc:mysql://localhost/hospitaldb", "root", "adhikesavan05");
		        PreparedStatement ps = con.prepareStatement("select * from patientinfo where patient_name =?");
		        ps.setString(1, patient_name);
		        ResultSet rs = ps.executeQuery();
		        int count = 0;
		        while (rs.next()) {
		            System.out.println("Patient_id =" + rs.getInt(1));
